@model AcxiomCrm.ViewModels.Dashboard.DashboardViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "CRM Analytics Dashboard";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h2 class="h4 fw-bold mb-1">
            <i class="bi bi-speedometer2 text-primary me-2"></i>CRM Analytics Dashboard
        </h2>
        <p class="text-muted small mb-0">Role-scoped performance metrics, pipeline intelligence, and operational tracking</p>
    </div>
    
    <div class="d-flex align-items-center gap-2">
        <span class="small text-muted fw-semibold me-1">Filter Period:</span>
        <div class="btn-group btn-group-sm shadow-sm" role="group">
            <a asp-action="Index" asp-route-dateFilter="All" class="btn @(Model.DateFilter == "All" ? "btn-primary" : "btn-outline-secondary")">All Time</a>
            <a asp-action="Index" asp-route-dateFilter="Today" class="btn @(Model.DateFilter == "Today" ? "btn-primary" : "btn-outline-secondary")">Today</a>
            <a asp-action="Index" asp-route-dateFilter="ThisWeek" class="btn @(Model.DateFilter == "ThisWeek" ? "btn-primary" : "btn-outline-secondary")">This Week</a>
            <a asp-action="Index" asp-route-dateFilter="ThisMonth" class="btn @(Model.DateFilter == "ThisMonth" ? "btn-primary" : "btn-outline-secondary")">This Month</a>
        </div>
    </div>
</div>

<!-- Primary KPI Cards Row -->
<div class="row g-3 mb-4">
    <!-- Total Customers -->
    <div class="col-xl-3 col-sm-6">
        <div class="card h-100 border-0 shadow-sm border-start border-primary border-4">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-bold">Total Customers</div>
                        <div class="h3 fw-bold mb-0 text-primary">@Model.TotalCustomers</div>
                        <div class="small text-muted mt-1">Active customer base</div>
                    </div>
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Leads -->
    <div class="col-xl-3 col-sm-6">
        <div class="card h-100 border-0 shadow-sm border-start border-info border-4">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-bold">Leads In Scope</div>
                        <div class="h3 fw-bold mb-0 text-info">@Model.TotalLeads</div>
                        <div class="small text-muted mt-1">
                            <span class="text-success fw-semibold">@Model.OpenLeads Open</span> &bull; 
                            <span class="text-primary fw-semibold">@Model.ConvertedLeads Converted</span>
                        </div>
                    </div>
                    <div class="bg-info bg-opacity-10 text-info rounded-circle p-3">
                        <i class="bi bi-funnel-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Pipeline Value -->
    <div class="col-xl-3 col-sm-6">
        <div class="card h-100 border-0 shadow-sm border-start border-success border-4">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-bold">Active Pipeline</div>
                        <div class="h4 fw-bold mb-0 text-success">₹@Model.TotalPipelineValue.ToString("N0")</div>
                        <div class="small text-muted mt-1">
                            Weighted: <span class="fw-semibold text-dark">₹@Model.WeightedPipelineValue.ToString("N0")</span>
                        </div>
                    </div>
                    <div class="bg-success bg-opacity-10 text-success rounded-circle p-3">
                        <i class="bi bi-cash-stack fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Opportunities & Follow-ups -->
    <div class="col-xl-3 col-sm-6">
        <div class="card h-100 border-0 shadow-sm border-start border-warning border-4">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-bold">Opportunities / Deals</div>
                        <div class="h3 fw-bold mb-0 text-warning">@Model.TotalOpportunities</div>
                        <div class="small text-muted mt-1">
                            <span class="text-success fw-semibold">@Model.WonOpportunities Won</span> &bull; 
                            <span class="text-danger fw-semibold">@Model.LostOpportunities Lost</span>
                        </div>
                    </div>
                    <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-3">
                        <i class="bi bi-briefcase-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Secondary Operational Bar -->
<div class="card mb-4 border-0 shadow-sm bg-light">
    <div class="card-body py-2 px-3">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 text-secondary small">
            <div>
                <i class="bi bi-calendar-event me-1 text-primary"></i>
                Pending Follow-Ups: <strong class="text-dark">@Model.PendingFollowUps</strong>
            </div>
            <div>
                <i class="bi bi-check2-circle me-1 text-success"></i>
                Completed Follow-Ups: <strong class="text-success">@Model.CompletedFollowUps</strong>
            </div>
            <div>
                <i class="bi bi-exclamation-triangle me-1 text-danger"></i>
                Overdue Follow-Ups: 
                <span class="badge @(Model.OverdueFollowUps > 0 ? "bg-danger" : "bg-success")">
                    @Model.OverdueFollowUps
                </span>
            </div>
            <div class="ms-auto">
                <a asp-controller="FollowUp" asp-action="Index" class="btn btn-sm btn-outline-primary py-0">View Follow-Ups &rarr;</a>
            </div>
        </div>
    </div>
</div>

<!-- Chart.js Visual Charts Row -->
<div class="row g-4 mb-4">
    <!-- Chart 1: Lead Status Doughnut -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-pie-chart-fill text-info me-2"></i>Lead Status Breakdown
                </h6>
                <span class="badge bg-light text-muted border">Total: @Model.TotalLeads</span>
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center p-3">
                <div style="position: relative; height: 260px; width: 100%;">
                    <canvas id="leadStatusChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart 2: Pipeline Stage Bar Chart -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-bar-chart-fill text-primary me-2"></i>Opportunity Pipeline by Stage
                </h6>
                <span class="badge bg-light text-muted border">Value (INR)</span>
            </div>
            <div class="card-body p-3">
                <div style="position: relative; height: 260px; width: 100%;">
                    <canvas id="pipelineStageChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart 3: Monthly Sales / Performance Trend -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-graph-up-arrow text-success me-2"></i>Opportunity Trend (Last 6 Months)
                </h6>
                <span class="badge bg-light text-muted border">Created Value</span>
            </div>
            <div class="card-body p-3">
                <div style="position: relative; height: 260px; width: 100%;">
                    <canvas id="monthlySalesChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Operational Tables: Recent Leads & Upcoming Follow-Ups -->
<div class="row g-4 mb-4">
    <!-- Recent Leads -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-person-lines-fill text-primary me-2"></i>Recent Leads
                </h6>
                <a asp-controller="Lead" asp-action="Index" class="btn btn-link btn-sm p-0 text-decoration-none">View All &rarr;</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th>Lead</th>
                            <th>Company</th>
                            <th>Status</th>
                            <th>Expected</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RecentLeads.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">No leads available.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var lead in Model.RecentLeads)
                            {
                                var badge = lead.Status switch
                                {
                                    "New" => "bg-primary",
                                    "Contacted" => "bg-info text-dark",
                                    "Qualified" => "bg-success",
                                    "Converted" => "bg-purple text-white",
                                    _ => "bg-secondary"
                                };
                                <tr>
                                    <td>
                                        <a asp-controller="Lead" asp-action="Details" asp-route-id="@lead.LeadId" class="fw-bold text-decoration-none">
                                            @lead.LeadName
                                        </a>
                                        <div class="text-muted" style="font-size: 0.75rem;">@lead.LeadCode</div>
                                    </td>
                                    <td>@(lead.CompanyName ?? "-")</td>
                                    <td><span class="badge @badge">@lead.Status</span></td>
                                    <td class="fw-semibold">₹@lead.ExpectedValue.ToString("N0")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Upcoming Follow-Ups -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-clock-history text-warning me-2"></i>Upcoming Follow-Ups
                </h6>
                <a asp-controller="FollowUp" asp-action="Index" class="btn btn-link btn-sm p-0 text-decoration-none">Schedule &rarr;</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th>Due Date</th>
                            <th>Remarks / Purpose</th>
                            <th>Type</th>
                            <th>Target</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.UpcomingFollowUps.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">No upcoming follow-ups scheduled.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var fu in Model.UpcomingFollowUps)
                            {
                                var isOverdue = fu.FollowUpDate.Date < DateTime.Today;
                                <tr>
                                    <td>
                                        <span class="@(isOverdue ? "text-danger fw-bold" : "text-dark")">
                                            @fu.FollowUpDate.ToString("dd MMM, hh:mm tt")
                                        </span>
                                    </td>
                                    <td class="fw-semibold">@(string.IsNullOrWhiteSpace(fu.Remarks) ? "General Follow-Up" : fu.Remarks)</td>
                                    <td><span class="badge bg-light text-dark border">@fu.FollowUpType</span></td>
                                    <td class="text-truncate" style="max-width: 140px;">
                                        @(fu.Customer?.CustomerName ?? fu.Lead?.LeadName ?? "General")
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Parse data from model
        const leadStatusLabels = @Html.Raw(JsonSerializer.Serialize(Model.LeadStatusLabels));
        const leadStatusCounts = @Html.Raw(JsonSerializer.Serialize(Model.LeadStatusCounts));

        const pipelineStageLabels = @Html.Raw(JsonSerializer.Serialize(Model.PipelineStageLabels));
        const pipelineStageAmounts = @Html.Raw(JsonSerializer.Serialize(Model.PipelineStageAmounts));

        const monthlyLabels = @Html.Raw(JsonSerializer.Serialize(Model.MonthlySalesLabels));
        const monthlyAmounts = @Html.Raw(JsonSerializer.Serialize(Model.MonthlySalesAmounts));

        // Chart 1: Lead Status Doughnut Chart
        const leadCtx = document.getElementById('leadStatusChart');
        if (leadCtx) {
            new Chart(leadCtx, {
                type: 'doughnut',
                data: {
                    labels: leadStatusLabels,
                    datasets: [{
                        data: leadStatusCounts,
                        backgroundColor: [
                            '#0d6efd', // New (Primary Blue)
                            '#0dcaf0', // Contacted (Cyan)
                            '#198754', // Qualified (Green)
                            '#6f42c1', // Converted (Purple)
                            '#dc3545'  // Lost (Red)
                        ],
                        borderWidth: 2,
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { boxWidth: 12, font: { size: 11 } }
                        }
                    },
                    cutout: '65%'
                }
            });
        }

        // Chart 2: Pipeline Stage Bar Chart
        const pipelineCtx = document.getElementById('pipelineStageChart');
        if (pipelineCtx) {
            new Chart(pipelineCtx, {
                type: 'bar',
                data: {
                    labels: pipelineStageLabels,
                    datasets: [{
                        label: 'Stage Value (₹)',
                        data: pipelineStageAmounts,
                        backgroundColor: [
                            'rgba(13, 110, 253, 0.8)',
                            'rgba(255, 193, 7, 0.8)',
                            'rgba(13, 202, 240, 0.8)',
                            'rgba(25, 135, 84, 0.8)',
                            'rgba(220, 53, 69, 0.8)'
                        ],
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return '₹' + (value >= 1000 ? (value / 1000) + 'k' : value);
                                }
                            }
                        }
                    }
                }
            });
        }

        // Chart 3: Monthly Sales Line Chart
        const monthlyCtx = document.getElementById('monthlySalesChart');
        if (monthlyCtx) {
            new Chart(monthlyCtx, {
                type: 'line',
                data: {
                    labels: monthlyLabels,
                    datasets: [{
                        label: 'Opportunity Volume (₹)',
                        data: monthlyAmounts,
                        borderColor: '#198754',
                        backgroundColor: 'rgba(25, 135, 84, 0.12)',
                        fill: true,
                        tension: 0.35,
                        pointBackgroundColor: '#198754',
                        pointRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return '₹' + (value >= 1000 ? (value / 1000) + 'k' : value);
                                }
                            }
                        }
                    }
                }
            });
        }
    });
</script>
}
