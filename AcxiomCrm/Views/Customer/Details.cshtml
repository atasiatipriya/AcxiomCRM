@model AcxiomCrm.Models.Customer

@{
    ViewData["Title"] = "Customer: " + Model.CustomerName;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 fw-bold mb-1">@Model.CustomerName</h2>
        <span class="badge @(Model.Status == "Active" ? "bg-success" : "bg-secondary")">@Model.Status</span>
        <span class="text-muted small ms-2">Code: <strong class="text-primary">@Model.CustomerCode</strong></span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit Customer
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header">Contact & Company Information</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted small">Email</dt>
                    <dd class="col-sm-8"><a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a></dd>

                    <dt class="col-sm-4 text-muted small">Phone</dt>
                    <dd class="col-sm-8">@Model.Phone</dd>

                    <dt class="col-sm-4 text-muted small">Company</dt>
                    <dd class="col-sm-8">@(Model.CompanyName ?? "-")</dd>

                    <dt class="col-sm-4 text-muted small">Address</dt>
                    <dd class="col-sm-8">@(Model.Address ?? "-")</dd>

                    <dt class="col-sm-4 text-muted small">City / State</dt>
                    <dd class="col-sm-8">@($"{Model.City ?? "-"}, {Model.State ?? "-"}")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header">System & Ownership Metadata</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted small">Customer ID</dt>
                    <dd class="col-sm-8">#@Model.CustomerId</dd>

                    <dt class="col-sm-4 text-muted small">Created By</dt>
                    <dd class="col-sm-8"><span class="badge bg-light text-dark border">@Model.CreatedBy</span></dd>

                    <dt class="col-sm-4 text-muted small">Created Date</dt>
                    <dd class="col-sm-8">@Model.CreatedDate.ToString("f")</dd>

                    <dt class="col-sm-4 text-muted small">Opportunities</dt>
                    <dd class="col-sm-8"><span class="badge bg-primary">@Model.Opportunities.Count</span></dd>

                    <dt class="col-sm-4 text-muted small">Follow-Ups</dt>
                    <dd class="col-sm-8"><span class="badge bg-info">@Model.FollowUps.Count</span></dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Linked Opportunities</span>
        <span class="badge bg-secondary">@Model.Opportunities.Count</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
                <thead>
                    <tr>
                        <th>Opportunity Name</th>
                        <th>Amount</th>
                        <th>Stage</th>
                        <th>Probability</th>
                        <th>Close Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Opportunities.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-3 text-muted small">No linked opportunities yet.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var opp in Model.Opportunities)
                        {
                            <tr>
                                <td>@opp.OpportunityName</td>
                                <td class="fw-bold">@opp.Amount.ToString("C")</td>
                                <td><span class="badge bg-secondary">@opp.Stage</span></td>
                                <td>@opp.Probability%</td>
                                <td>@opp.ExpectedCloseDate.ToString("dd MMM yyyy")</td>
                                <td><span class="badge bg-light text-dark border">@opp.Status</span></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
