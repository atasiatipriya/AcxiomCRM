@model AcxiomCrm.ViewModels.Customers.CustomerListViewModel

@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 fw-bold mb-1">Customer Management</h2>
        <p class="text-muted small mb-0">Manage master customer records, contacts, and account status</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm px-3 shadow-sm">
        <i class="bi bi-person-plus-fill me-1"></i> Add Customer
    </a>
</div>

<div class="card mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search by name, email, phone, or company..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Active" selected="@(Model.StatusFilter == "Active")">Active</option>
                    <option value="Inactive" selected="@(Model.StatusFilter == "Inactive")">Inactive</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-3">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Customer Name</th>
                    <th>Contact Info</th>
                    <th>Company</th>
                    <th>Status</th>
                    <th>Created By</th>
                    <th>Created Date</th>
                    <th class="text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Customers.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-1"></i>
                            No customer records found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var c in Model.Customers)
                    {
                        <tr>
                            <td class="fw-semibold text-primary">@c.CustomerCode</td>
                            <td class="fw-bold">
                                <a asp-action="Details" asp-route-id="@c.CustomerId" class="text-dark text-decoration-none">
                                    @c.CustomerName
                                </a>
                            </td>
                            <td>
                                <div><i class="bi bi-envelope me-1 text-muted small"></i>@c.Email</div>
                                <div class="text-muted small"><i class="bi bi-telephone me-1"></i>@c.Phone</div>
                            </td>
                            <td>@(c.CompanyName ?? "-")</td>
                            <td>
                                <span class="badge @(c.Status == "Active" ? "bg-success" : "bg-secondary")">
                                    @c.Status
                                </span>
                            </td>
                            <td class="small text-muted">@c.CreatedBy</td>
                            <td class="small text-muted">@c.CreatedDate.ToString("dd MMM yyyy")</td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@c.CustomerId" class="btn btn-outline-secondary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@c.CustomerId" class="btn btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (c.Status == "Active")
                                    {
                                        <form asp-action="Delete" asp-route-id="@c.CustomerId" method="post" class="d-inline" onsubmit="return confirm('Deactivate customer @c.CustomerName?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Deactivate">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
