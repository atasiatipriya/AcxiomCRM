@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var userRole = User.IsInRole("Admin") ? "Admin" : User.IsInRole("Manager") ? "Manager" : "SalesExecutive";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcxiomCRM</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (isAuthenticated)
{
    <div class="crm-wrapper">
        <div class="crm-sidebar-backdrop" id="sidebarBackdrop"></div>
        <aside class="crm-sidebar" id="sidebar">
            <a class="crm-sidebar-brand" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-briefcase-fill text-primary"></i>
                <span>AcxiomCRM</span>
            </a>

            <ul class="crm-sidebar-nav">
                <li class="crm-nav-section-title">Core CRM</li>
                <li class="crm-nav-item">
                    <a class="crm-nav-link @(currentController == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li class="crm-nav-item">
                    <a class="crm-nav-link @(currentController == "Customer" ? "active" : "")" asp-controller="Customer" asp-action="Index">
                        <i class="bi bi-people-fill"></i>
                        <span>Customers</span>
                    </a>
                </li>
                <li class="crm-nav-item">
                    <a class="crm-nav-link @(currentController == "Lead" ? "active" : "")" asp-controller="Lead" asp-action="Index">
                        <i class="bi bi-funnel-fill"></i>
                        <span>Leads</span>
                    </a>
                </li>
                <li class="crm-nav-item">
                    <a class="crm-nav-link @(currentController == "FollowUp" ? "active" : "")" asp-controller="FollowUp" asp-action="Index">
                        <i class="bi bi-calendar-check"></i>
                        <span>Follow-Ups</span>
                    </a>
                </li>
                <li class="crm-nav-item">
                    <a class="crm-nav-link @(currentController == "Opportunity" ? "active" : "")" asp-controller="Opportunity" asp-action="Index">
                        <i class="bi bi-graph-up-arrow"></i>
                        <span>Opportunities</span>
                    </a>
                </li>
                <li class="crm-nav-item">
                    <a class="crm-nav-link @(currentController == "Activity" ? "active" : "")" asp-controller="Activity" asp-action="Index">
                        <i class="bi bi-clock-history"></i>
                        <span>Activities</span>
                    </a>
                </li>

                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                {
                    <li class="crm-nav-section-title">Analytics</li>
                    <li class="crm-nav-item">
                        <a class="crm-nav-link @(currentController == "Reports" ? "active" : "")" asp-controller="Reports" asp-action="Index">
                            <i class="bi bi-file-earmark-bar-graph"></i>
                            <span>Reports</span>
                        </a>
                    </li>
                }

                @if (User.IsInRole("Admin"))
                {
                    <li class="crm-nav-section-title">Administration</li>
                    <li class="crm-nav-item">
                        <a class="crm-nav-link @(currentController == "Users" ? "active" : "")" asp-controller="Users" asp-action="Index">
                            <i class="bi bi-person-gear"></i>
                            <span>User Management</span>
                        </a>
                    </li>
                    <li class="crm-nav-item">
                        <a class="crm-nav-link @(currentController == "AuditLogs" ? "active" : "")" asp-controller="AuditLogs" asp-action="Index">
                            <i class="bi bi-shield-check"></i>
                            <span>Audit Logs</span>
                        </a>
                    </li>
                }
            </ul>

            <div class="p-3 border-top border-secondary border-opacity-25 small text-muted">
                <div class="fw-semibold text-light text-truncate">@User.Identity?.Name</div>
                <div>Role: <span class="text-info">@userRole</span></div>
            </div>
        </aside>

        <div class="crm-main-content">
            <header class="crm-topbar">
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-outline-secondary btn-sm d-lg-none" id="sidebarToggle" type="button">
                        <i class="bi bi-list"></i>
                    </button>
                    <span class="fw-semibold text-secondary">AcxiomCRM Management Portal</span>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <span class="badge @(userRole == "Admin" ? "bg-danger" : userRole == "Manager" ? "bg-primary" : "bg-success") px-2 py-1">
                        @userRole
                    </span>

                    <div class="dropdown">
                        <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle me-1"></i> @User.Identity?.Name
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li class="dropdown-header small">Signed in as <strong>@userRole</strong></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm w-100">
                                        <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="crm-page-body">
                <partial name="_Alerts" />
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <i class="bi bi-briefcase-fill text-primary me-2"></i>AcxiomCRM
            </a>
            <div class="navbar-nav ms-auto gap-2">
                <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Sign In</a>
                <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Register</a>
            </div>
        </div>
    </nav>
    <main class="container py-4">
        <partial name="_Alerts" />
        @RenderBody()
    </main>
}

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
