@model AcxiomCrm.ViewModels.Leads.LeadConvertViewModel

@{
    ViewData["Title"] = "Convert Lead to Customer";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2 class="h4 fw-bold mb-0">Lead Conversion Wizard</h2>
                <span class="text-muted small">Converting Lead: <strong class="text-primary">@Model.LeadCode</strong></span>
            </div>
            <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Cancel
            </a>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="mb-0 fs-6"><i class="bi bi-magic me-2"></i> Convert Prospect into Customer & Deal</h5>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-info small mb-4">
                    Converting this lead will create an active Customer record in the CRM master database, change this lead's status to <strong>Converted</strong>, and optionally generate an active sales Opportunity in your pipeline.
                </div>

                <form asp-action="Convert" method="post" id="leadConvertForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="LeadId" />
                    <input type="hidden" asp-for="LeadCode" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">1. New Customer Information</h6>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="CustomerName" class="form-label small fw-semibold">Customer / Contact Name <span class="text-danger">*</span></label>
                            <input asp-for="CustomerName" class="form-control" />
                            <span asp-validation-for="CustomerName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label small fw-semibold">Company Name</label>
                            <input asp-for="CompanyName" class="form-control" />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label small fw-semibold">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label small fw-semibold">Phone Number <span class="text-danger">* (10-digit)</span></label>
                            <input asp-for="Phone" class="form-control" maxlength="10" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">2. Initial Sales Opportunity (Pipeline)</h6>
                    <div class="form-check form-switch mb-3">
                        <input asp-for="CreateOpportunity" class="form-check-input" id="createOppSwitch" />
                        <label class="form-check-label fw-semibold small" for="createOppSwitch">Create an initial active sales opportunity</label>
                    </div>

                    <div id="oppSection" class="p-3 bg-light rounded border mb-4">
                        <div class="mb-3">
                            <label asp-for="OpportunityName" class="form-label small fw-semibold">Opportunity Name</label>
                            <input asp-for="OpportunityName" class="form-control" />
                            <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="OpportunityAmount" class="form-label small fw-semibold">Opportunity Amount (₹)</label>
                                <input asp-for="OpportunityAmount" class="form-control" type="number" step="0.01" />
                                <span asp-validation-for="OpportunityAmount" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ExpectedCloseDate" class="form-label small fw-semibold">Expected Close Date</label>
                                <input asp-for="ExpectedCloseDate" class="form-control" type="date" />
                                <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-success px-4 fw-semibold">
                            <i class="bi bi-check-circle-fill me-1"></i> Finalize Conversion
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const oppSwitch = document.getElementById("createOppSwitch");
        const oppSection = document.getElementById("oppSection");

        if (oppSwitch && oppSection) {
            function toggleOppSection() {
                oppSection.style.display = oppSwitch.checked ? "block" : "none";
            }
            oppSwitch.addEventListener("change", toggleOppSection);
            toggleOppSection();
        }
    </script>
}
