@model AcxiomCrm.ViewModels.Leads.LeadFormViewModel

@{
    ViewData["Title"] = "Edit Lead - " + Model.LeadName;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2 class="h4 fw-bold mb-0">Edit Lead</h2>
                <span class="text-muted small">Code: <strong class="text-primary">@Model.LeadCode</strong></span>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="LeadId" />
                    <input type="hidden" asp-for="LeadCode" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="LeadName" class="form-label small fw-semibold">Lead Contact Name <span class="text-danger">*</span></label>
                            <input asp-for="LeadName" class="form-control" />
                            <span asp-validation-for="LeadName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Lead Code</label>
                            <input class="form-control bg-light" value="@Model.LeadCode" readonly />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label small fw-semibold">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label small fw-semibold">Phone Number <span class="text-danger">*</span></label>
                            <input asp-for="Phone" class="form-control" maxlength="10" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label small fw-semibold">Company Name</label>
                            <input asp-for="CompanyName" class="form-control" />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Source" class="form-label small fw-semibold">Lead Source</label>
                            <select asp-for="Source" class="form-select">
                                <option value="Website">Website</option>
                                <option value="Referral">Referral</option>
                                <option value="Cold Call">Cold Call</option>
                                <option value="Advertisement">Advertisement</option>
                                <option value="Partner">Partner</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="Source" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label small fw-semibold">Status (Workflow Rules Apply)</label>
                            <select asp-for="Status" class="form-select">
                                <option value="New">New</option>
                                <option value="Contacted">Contacted</option>
                                <option value="Qualified">Qualified</option>
                                <option value="Unqualified">Unqualified</option>
                                <option value="Lost">Lost</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ExpectedValue" class="form-label small fw-semibold">Expected Value (₹)</label>
                            <input asp-for="ExpectedValue" class="form-control" type="number" step="0.01" min="0" />
                            <span asp-validation-for="ExpectedValue" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="AssignedTo" class="form-label small fw-semibold">Assigned Sales Rep</label>
                            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                            {
                                <select asp-for="AssignedTo" asp-items="ViewBag.UsersList" class="form-select">
                                    <option value="">Unassigned</option>
                                </select>
                            }
                            else
                            {
                                <input asp-for="AssignedTo" class="form-control bg-light" readonly />
                            }
                            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">Update Lead</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
