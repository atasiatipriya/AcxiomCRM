@model AcxiomCrm.Models.Lead

@{
    ViewData["Title"] = "Lead: " + Model.LeadName;

    var statusBadgeClass = Model.Status switch
    {
        "New" => "bg-primary",
        "Contacted" => "bg-warning text-dark",
        "Qualified" => "bg-info text-dark",
        "Converted" => "bg-success",
        "Unqualified" => "bg-secondary",
        "Lost" => "bg-danger",
        _ => "bg-secondary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 fw-bold mb-1">@Model.LeadName</h2>
        <span class="badge @statusBadgeClass fs-6">@Model.Status</span>
        <span class="text-muted small ms-2">Code: <strong class="text-primary">@Model.LeadCode</strong></span>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Status != "Converted")
        {
            @if (Model.Status == "Qualified")
            {
                <a asp-action="Convert" asp-route-id="@Model.LeadId" class="btn btn-success btn-sm">
                    <i class="bi bi-person-check-fill me-1"></i> Convert to Customer
                </a>
            }
            <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-primary btn-sm">
                <i class="bi bi-pencil me-1"></i> Edit Lead
            </a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

@if (Model.Status != "Converted")
{
    <div class="card mb-4 border-primary border-opacity-25 bg-light">
        <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="small fw-semibold text-secondary">
                <i class="bi bi-arrow-repeat me-1"></i> Quick Workflow Transition:
            </div>
            <div class="d-flex flex-wrap gap-2">
                @if (Model.Status == "New")
                {
                    <form asp-action="ChangeStatus" asp-route-id="@Model.LeadId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="newStatus" value="Contacted" />
                        <button type="submit" class="btn btn-sm btn-warning">Advance to Contacted</button>
                    </form>
                    <form asp-action="ChangeStatus" asp-route-id="@Model.LeadId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="newStatus" value="Unqualified" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Mark Unqualified</button>
                    </form>
                    <form asp-action="ChangeStatus" asp-route-id="@Model.LeadId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="newStatus" value="Lost" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Mark Lost</button>
                    </form>
                }
                else if (Model.Status == "Contacted")
                {
                    <form asp-action="ChangeStatus" asp-route-id="@Model.LeadId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="newStatus" value="Qualified" />
                        <button type="submit" class="btn btn-sm btn-info text-dark fw-semibold">Advance to Qualified</button>
                    </form>
                    <form asp-action="ChangeStatus" asp-route-id="@Model.LeadId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="newStatus" value="Unqualified" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Mark Unqualified</button>
                    </form>
                    <form asp-action="ChangeStatus" asp-route-id="@Model.LeadId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="newStatus" value="Lost" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Mark Lost</button>
                    </form>
                }
                else if (Model.Status == "Qualified")
                {
                    <a asp-action="Convert" asp-route-id="@Model.LeadId" class="btn btn-sm btn-success fw-semibold">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Launch Customer Conversion Wizard
                    </a>
                    <form asp-action="ChangeStatus" asp-route-id="@Model.LeadId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="newStatus" value="Lost" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Mark Lost</button>
                    </form>
                }
                else if (Model.Status is "Unqualified" or "Lost")
                {
                    <form asp-action="ChangeStatus" asp-route-id="@Model.LeadId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="newStatus" value="Contacted" />
                        <button type="submit" class="btn btn-sm btn-outline-primary">Re-engage Lead (Contacted)</button>
                    </form>
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-success d-flex align-items-center gap-2 mb-4">
        <i class="bi bi-check-circle-fill fs-5"></i>
        <div>
            <strong>Converted Lead:</strong> This lead has been successfully converted into an active Customer account. Its details are preserved for reporting and audit history.
        </div>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header">Contact & Prospect Details</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted small">Email</dt>
                    <dd class="col-sm-8"><a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a></dd>

                    <dt class="col-sm-4 text-muted small">Phone</dt>
                    <dd class="col-sm-8">@Model.Phone</dd>

                    <dt class="col-sm-4 text-muted small">Company</dt>
                    <dd class="col-sm-8">@(Model.CompanyName ?? "-")</dd>

                    <dt class="col-sm-4 text-muted small">Source</dt>
                    <dd class="col-sm-8"><span class="badge bg-light text-dark border">@Model.Source</span></dd>

                    <dt class="col-sm-4 text-muted small">Expected Value</dt>
                    <dd class="col-sm-8 fw-bold text-success fs-5">@Model.ExpectedValue.ToString("C")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header">Assignment & Activity Metadata</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted small">Lead ID</dt>
                    <dd class="col-sm-8">#@Model.LeadId</dd>

                    <dt class="col-sm-4 text-muted small">Assigned To</dt>
                    <dd class="col-sm-8"><span class="badge bg-light text-dark border">@(Model.AssignedTo ?? "Unassigned")</span></dd>

                    <dt class="col-sm-4 text-muted small">Captured Date</dt>
                    <dd class="col-sm-8">@Model.CreatedDate.ToString("f")</dd>

                    <dt class="col-sm-4 text-muted small">Opportunities</dt>
                    <dd class="col-sm-8"><span class="badge bg-primary">@Model.Opportunities.Count</span></dd>

                    <dt class="col-sm-4 text-muted small">Follow-Ups</dt>
                    <dd class="col-sm-8"><span class="badge bg-info">@Model.FollowUps.Count</span></dd>
                </dl>
            </div>
        </div>
    </div>
</div>
