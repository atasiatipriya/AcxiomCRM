@{
    ViewData["Title"] = "Access Denied - 403";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card border-0 shadow-sm p-4">
            <div class="card-body">
                <div class="display-1 text-danger fw-bold mb-3">403</div>
                <h3 class="fw-bold text-dark">Access Denied</h3>
                <p class="text-muted mb-4">
                    You do not have the required role or permission to access this resource.
                    If you believe this is an error, please reach out to your system administrator.
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
                        Return to Dashboard
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-secondary">Sign In as Another User</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
