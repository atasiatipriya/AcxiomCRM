@model AcxiomCrm.ViewModels.Account.LoginViewModel

@{
    ViewData["Title"] = "Sign In - AcxiomCRM";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <h3 class="fw-bold text-primary">AcxiomCRM</h3>
                    <p class="text-muted small">Sign in to access your sales workspace</p>
                </div>

                <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold">Email Address</label>
                        <input asp-for="Email" class="form-control" id="loginEmail" placeholder="name@company.com" autocomplete="username" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-semibold">Password</label>
                        <input asp-for="Password" class="form-control" id="loginPassword" placeholder="••••••••" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small text-muted">Remember this device</label>
                    </div>

                    <div class="d-grid gap-2 mb-3">
                        <button type="submit" class="btn btn-primary fw-semibold">Sign In</button>
                    </div>

                    <div class="text-center">
                        <span class="small text-muted">Don't have an account? </span>
                        <a asp-action="Register" asp-route-returnurl="@ViewData["ReturnUrl"]" class="small text-decoration-none fw-semibold">Register here</a>
                    </div>
                </form>
            </div>
            <div class="card-footer bg-light p-3 border-top-0">
                <div class="small text-muted fw-semibold mb-2 text-center">Demo Viva Logins (Click to Autofill):</div>
                <div class="d-flex flex-wrap gap-1 justify-content-center">
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="fillCreds('admin@acxiomcrm.local', 'Admin@12345')">Admin</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="fillCreds('manager@acxiomcrm.local', 'Manager@12345')">Manager</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="fillCreds('sales@acxiomcrm.local', 'Sales@12345')">Sales Exec</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillCreds(email, password) {
            document.getElementById('loginEmail').value = email;
            document.getElementById('loginPassword').value = password;
        }
    </script>
}
