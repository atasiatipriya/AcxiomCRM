@model AcxiomCrm.ViewModels.Activities.ActivityListViewModel

@{
    ViewData["Title"] = "Activities";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 fw-bold mb-1">Activity Tracking</h2>
        <p class="text-muted small mb-0">Record and review client touchpoints: phone calls, meetings, emails, and tasks</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm px-3 shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Log Activity
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="card shadow-sm h-100 kpi-card">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Calls</span>
                    <h3 class="fw-bold mb-0 text-primary">@Model.CallsCount</h3>
                </div>
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary">
                    <i class="bi bi-telephone-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card shadow-sm h-100 kpi-card">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Meetings</span>
                    <h3 class="fw-bold mb-0 text-success">@Model.MeetingsCount</h3>
                </div>
                <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success">
                    <i class="bi bi-people-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card shadow-sm h-100 kpi-card">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Emails</span>
                    <h3 class="fw-bold mb-0 text-info">@Model.EmailsCount</h3>
                </div>
                <div class="bg-info bg-opacity-10 p-3 rounded-circle text-info">
                    <i class="bi bi-envelope-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card shadow-sm h-100 kpi-card">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Tasks</span>
                    <h3 class="fw-bold mb-0 text-warning">@Model.TasksCount</h3>
                </div>
                <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning">
                    <i class="bi bi-check2-square fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search subject, notes, or client..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="type" class="form-select">
                    <option value="">All Activity Types</option>
                    <option value="Call" selected="@(Model.TypeFilter == "Call")">Call</option>
                    <option value="Meeting" selected="@(Model.TypeFilter == "Meeting")">Meeting</option>
                    <option value="Email" selected="@(Model.TypeFilter == "Email")">Email</option>
                    <option value="Task" selected="@(Model.TypeFilter == "Task")">Task</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Completed</option>
                    <option value="Pending" selected="@(Model.StatusFilter == "Pending")">Pending</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Subject</th>
                    <th>Linked Record</th>
                    <th>Activity Date</th>
                    <th>Status</th>
                    <th>Assigned To</th>
                    <th class="text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Activities.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="bi bi-clock-history fs-2 d-block mb-1"></i>
                            No activity logs found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var a in Model.Activities)
                    {
                        var icon = a.ActivityType switch
                        {
                            "Call" => "bi-telephone text-primary",
                            "Meeting" => "bi-people text-success",
                            "Email" => "bi-envelope text-info",
                            "Task" => "bi-check2-square text-warning",
                            _ => "bi-dot text-secondary"
                        };

                        <tr>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi @icon me-1"></i> @a.ActivityType
                                </span>
                            </td>
                            <td class="fw-bold">
                                <a asp-action="Details" asp-route-id="@a.ActivityId" class="text-dark text-decoration-none">
                                    @a.Subject
                                </a>
                            </td>
                            <td>
                                @if (a.Customer != null)
                                {
                                    <a asp-controller="Customer" asp-action="Details" asp-route-id="@a.CustomerId" class="text-decoration-none small">
                                        <i class="bi bi-building me-1"></i> @a.Customer.CustomerName
                                    </a>
                                }
                                else if (a.Lead != null)
                                {
                                    <a asp-controller="Lead" asp-action="Details" asp-route-id="@a.LeadId" class="text-decoration-none small text-warning">
                                        <i class="bi bi-funnel me-1"></i> @a.Lead.LeadName
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td class="small text-muted">@a.ActivityDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                            <td>
                                <span class="badge @(a.Status == "Completed" ? "bg-success" : "bg-warning text-dark")">
                                    @a.Status
                                </span>
                            </td>
                            <td class="small text-muted">@(a.AssignedTo ?? "Unassigned")</td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <form asp-action="ToggleStatus" asp-route-id="@a.ActivityId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-secondary" title="Toggle Status">
                                            <i class="bi @(a.Status == "Completed" ? "bi-arrow-counterclockwise" : "bi-check-lg")"></i>
                                        </button>
                                    </form>
                                    <a asp-action="Details" asp-route-id="@a.ActivityId" class="btn btn-outline-secondary" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@a.ActivityId" class="btn btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
