@model AcxiomCrm.ViewModels.FollowUps.FollowUpListViewModel

@{
    ViewData["Title"] = "Follow-Ups";
    var today = DateTime.Today;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 fw-bold mb-1">Follow-Up Management</h2>
        <p class="text-muted small mb-0">Schedule client interactions, track reminders, and resolve overdue activities</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm px-3 shadow-sm">
        <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-primary border-2 shadow-sm kpi-card">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Due Today</span>
                    <h3 class="fw-bold mb-0 text-primary">@Model.TodayCount</h3>
                </div>
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary">
                    <i class="bi bi-clock-history fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-info border-2 shadow-sm kpi-card">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Upcoming</span>
                    <h3 class="fw-bold mb-0 text-info">@Model.UpcomingCount</h3>
                </div>
                <div class="bg-info bg-opacity-10 p-3 rounded-circle text-info">
                    <i class="bi bi-calendar-event fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-danger border-2 shadow-sm kpi-card">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Overdue</span>
                    <h3 class="fw-bold mb-0 text-danger">@Model.OverdueCount</h3>
                </div>
                <div class="bg-danger bg-opacity-10 p-3 rounded-circle text-danger">
                    <i class="bi bi-exclamation-triangle fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body p-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <ul class="nav nav-pills">
                <li class="nav-item">
                    <a class="nav-link @(Model.QuickFilter == "all" ? "active" : "")" asp-action="Index" asp-route-quickFilter="all">All</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(Model.QuickFilter == "today" ? "active" : "")" asp-action="Index" asp-route-quickFilter="today">Due Today</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(Model.QuickFilter == "upcoming" ? "active" : "")" asp-action="Index" asp-route-quickFilter="upcoming">Upcoming</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(Model.QuickFilter == "overdue" ? "active" : "")" asp-action="Index" asp-route-quickFilter="overdue">
                        Overdue <span class="badge bg-danger ms-1">@Model.OverdueCount</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(Model.QuickFilter == "completed" ? "active" : "")" asp-action="Index" asp-route-quickFilter="completed">Completed</a>
                </li>
            </ul>

            <form method="get" asp-action="Index" class="d-flex gap-2">
                <input type="hidden" name="quickFilter" value="@Model.QuickFilter" />
                <select name="type" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Types</option>
                    <option value="Call" selected="@(Model.TypeFilter == "Call")">Call</option>
                    <option value="Meeting" selected="@(Model.TypeFilter == "Meeting")">Meeting</option>
                    <option value="Email" selected="@(Model.TypeFilter == "Email")">Email</option>
                    <option value="Demo" selected="@(Model.TypeFilter == "Demo")">Demo</option>
                    <option value="Visit" selected="@(Model.TypeFilter == "Visit")">Visit</option>
                </select>
            </form>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Date & Time</th>
                    <th>Type</th>
                    <th>Associated Client / Lead</th>
                    <th>Remarks</th>
                    <th>Status</th>
                    <th>Assigned To</th>
                    <th class="text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.FollowUps.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="bi bi-calendar-check fs-2 d-block mb-1"></i>
                            No follow-up activities found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var f in Model.FollowUps)
                    {
                        var isOverdue = f.Status == "Planned" && f.FollowUpDate.Date < today;
                        var isToday = f.Status == "Planned" && f.FollowUpDate.Date == today;

                        <tr class="@(isOverdue ? "table-danger" : isToday ? "table-warning" : "")">
                            <td>
                                <div class="fw-bold @(isOverdue ? "text-danger" : "")">
                                    <i class="bi bi-calendar-event me-1"></i> @f.FollowUpDate.ToString("dd MMM yyyy, hh:mm tt")
                                </div>
                                @if (isOverdue)
                                {
                                    <span class="badge bg-danger text-uppercase" style="font-size: 0.65rem;">Overdue</span>
                                }
                                else if (isToday)
                                {
                                    <span class="badge bg-warning text-dark text-uppercase" style="font-size: 0.65rem;">Today</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi @(f.FollowUpType == "Call" ? "bi-telephone" : f.FollowUpType == "Meeting" ? "bi-people" : f.FollowUpType == "Email" ? "bi-envelope" : "bi-briefcase") me-1"></i>
                                    @f.FollowUpType
                                </span>
                            </td>
                            <td>
                                @if (f.Customer != null)
                                {
                                    <a asp-controller="Customer" asp-action="Details" asp-route-id="@f.CustomerId" class="fw-semibold text-decoration-none text-dark">
                                        <i class="bi bi-building me-1 text-primary"></i> @f.Customer.CustomerName
                                    </a>
                                    <div class="small text-muted">Customer (@f.Customer.CustomerCode)</div>
                                }
                                else if (f.Lead != null)
                                {
                                    <a asp-controller="Lead" asp-action="Details" asp-route-id="@f.LeadId" class="fw-semibold text-decoration-none text-dark">
                                        <i class="bi bi-funnel me-1 text-warning"></i> @f.Lead.LeadName
                                    </a>
                                    <div class="small text-muted">Lead (@f.Lead.LeadCode)</div>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="small" style="max-width: 250px;">
                                @(f.Remarks ?? "-")
                            </td>
                            <td>
                                <span class="badge @(f.Status == "Completed" ? "bg-success" : f.Status == "Planned" ? "bg-primary" : "bg-secondary")">
                                    @f.Status
                                </span>
                            </td>
                            <td class="small text-muted">@(f.AssignedTo ?? "Unassigned")</td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    @if (f.Status == "Planned")
                                    {
                                        <button type="button" class="btn btn-outline-success" title="Mark Completed" data-bs-toggle="modal" data-bs-target="#completeModal-@f.FollowUpId">
                                            <i class="bi bi-check2"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-warning text-dark" title="Reschedule" data-bs-toggle="modal" data-bs-target="#rescheduleModal-@f.FollowUpId">
                                            <i class="bi bi-arrow-repeat"></i>
                                        </button>
                                    }
                                    <a asp-action="Edit" asp-route-id="@f.FollowUpId" class="btn btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>

                                <!-- Complete Modal -->
                                <div class="modal fade text-start" id="completeModal-@f.FollowUpId" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <form asp-action="Complete" asp-route-id="@f.FollowUpId" method="post">
                                                @Html.AntiForgeryToken()
                                                <div class="modal-header">
                                                    <h5 class="modal-title fs-6 fw-bold">Complete Follow-Up</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p class="small text-muted mb-2">Mark follow-up as completed and capture interaction notes:</p>
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-semibold">Outcome / Notes</label>
                                                        <textarea name="remarks" class="form-control form-control-sm" rows="3" placeholder="Customer agreed to schedule demo next Tuesday..."></textarea>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-success btn-sm">Confirm Completed</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                                <!-- Reschedule Modal -->
                                <div class="modal fade text-start" id="rescheduleModal-@f.FollowUpId" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <form asp-action="Reschedule" asp-route-id="@f.FollowUpId" method="post">
                                                @Html.AntiForgeryToken()
                                                <div class="modal-header">
                                                    <h5 class="modal-title fs-6 fw-bold">Reschedule Follow-Up</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-semibold">New Date & Time <span class="text-danger">*</span></label>
                                                        <input type="datetime-local" name="newDate" class="form-control form-control-sm" min="@DateTime.Today.ToString("yyyy-MM-ddTHH:mm")" value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-ddT10:00")" required />
                                                        <div class="form-text small">Follow-up date cannot be earlier than today.</div>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-semibold">Reason / Note</label>
                                                        <input type="text" name="remarks" class="form-control form-control-sm" placeholder="Client requested call back tomorrow" />
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-warning btn-sm">Confirm Reschedule</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
