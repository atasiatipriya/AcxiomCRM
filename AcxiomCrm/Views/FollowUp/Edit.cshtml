@model AcxiomCrm.ViewModels.FollowUps.FollowUpFormViewModel

@{
    ViewData["Title"] = "Edit Follow-Up";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 fw-bold mb-0">Edit Follow-Up</h2>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="FollowUpId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label small fw-semibold">Customer</label>
                            <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select">
                                <option value="">-- None --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LeadId" class="form-label small fw-semibold">Lead</label>
                            <select asp-for="LeadId" asp-items="ViewBag.Leads" class="form-select">
                                <option value="">-- None --</option>
                            </select>
                            <span asp-validation-for="LeadId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="FollowUpDate" class="form-label small fw-semibold">Follow-Up Date & Time <span class="text-danger">*</span></label>
                            <input asp-for="FollowUpDate" class="form-control" type="datetime-local" />
                            <span asp-validation-for="FollowUpDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="FollowUpType" class="form-label small fw-semibold">Follow-Up Type <span class="text-danger">*</span></label>
                            <select asp-for="FollowUpType" class="form-select">
                                <option value="Call">Phone Call</option>
                                <option value="Meeting">Meeting</option>
                                <option value="Email">Email Communication</option>
                                <option value="Demo">Product Demo</option>
                                <option value="Visit">Site Visit</option>
                            </select>
                            <span asp-validation-for="FollowUpType" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label small fw-semibold">Status</label>
                            <select asp-for="Status" class="form-select">
                                <option value="Planned">Planned</option>
                                <option value="Completed">Completed</option>
                                <option value="Missed">Missed</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AssignedTo" class="form-label small fw-semibold">Assigned User</label>
                            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                            {
                                <select asp-for="AssignedTo" asp-items="ViewBag.Users" class="form-select">
                                    <option value="">Select Assignee</option>
                                </select>
                            }
                            else
                            {
                                <input asp-for="AssignedTo" class="form-control bg-light" readonly />
                            }
                            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Remarks" class="form-label small fw-semibold">Remarks</label>
                        <textarea asp-for="Remarks" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Remarks" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">Update Follow-Up</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
